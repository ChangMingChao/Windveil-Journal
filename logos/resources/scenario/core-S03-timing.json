{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S03",
  "name": "为一个愿望约定属于它的时机",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S03-set-timing.md",
    "api": ["logos/resources/api/wishes.yaml", "logos/resources/api/system.yaml"],
    "test_cases": "logos/resources/test/core-S03-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "Web Push",
      "test_strategy": "env-disable",
      "test_config": "APP_ENV=test 时不真实投递，仅写 reminder_outbox；配套 GET /api/test/outbox?user_id= 断言周预算与去重",
      "note": "env-disable 语义在此实现为「不调用真实推送服务，但按成功记账」，以便周预算与去重语义可被断言。因此 410 订阅失效与双通道失败无法在编排层模拟，见 not_orchestrated。"
    },
    {
      "name": "邮件服务",
      "test_strategy": "test-api",
      "test_config": "GET /api/test/latest-email?to={email}"
    },
    {
      "name": "系统时钟",
      "test_strategy": "fixed-value",
      "test_config": "POST /api/test/clock 注入固定时间；置 null 恢复真实时钟"
    },
    {
      "name": "LLM",
      "test_strategy": "mock-service",
      "test_config": "本地 OpenAI 兼容 mock"
    }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "固定时钟为 2026-09-01T12:00:00+08:00，使季节与自然周计算可复现",
      "mock": {
        "dependency": "系统时钟",
        "strategy": "fixed-value",
        "config": "POST /api/test/clock"
      },
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": "2026-09-01T12:00:00+08:00" },
      "expected_status": 204
    },
    {
      "step": "setup-2",
      "description": "建立匿名账号",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "body": { "timezone": "Asia/Shanghai" },
      "expected_status": 201,
      "extract": { "access_token": "body.access_token", "user_id": "body.user.id" }
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "恢复真实时钟",
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": null },
      "expected_status": 204
    },
    {
      "step": "teardown-2",
      "description": "清理全部愿望",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/wishes/{{item.id}}?confirm=true",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "for_each": "GET {{base_url}}/api/v1/wishes -> body.items",
      "expected_status": [204, 404]
    }
  ],
  "flows": [
    {
      "case_id": "ST-S03-01",
      "type": "normal",
      "description": "约定季节触发，时机到达后进入 outbox 并可点「我好像准备好了」",
      "covers_steps": "Step 1→22",
      "steps": [
        {
          "step": "前置：种下一个愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想在冬天学会滑雪" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "Step 4: 约定季节 → 冬",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "season", "season": "winter" },
          "expected_status": 200,
          "assert": [
            "body.state == 'brewing'",
            "body.timing.trigger_kind == 'time'",
            "body.timing.next_trigger_at != null",
            "contains(body.timing.label, '入冬')"
          ]
        },
        {
          "step": "Step 9: 时钟推进到入冬后再触发一轮调度",
          "mock": { "dependency": "系统时钟", "strategy": "fixed-value", "config": "POST /api/test/clock" },
          "method": "POST",
          "url": "{{base_url}}/api/test/clock",
          "body": { "now": "2026-12-08T09:00:00+08:00" },
          "expected_status": 204
        },
        {
          "step": "Step 11→17: 触发一轮调度",
          "mock": {
            "dependency": "Web Push",
            "strategy": "env-disable",
            "config": "不真实投递，仅写 reminder_outbox 并按成功记账"
          },
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.scanned >= 1", "body.enqueued == 1", "body.delivered == 1"]
        },
        {
          "step": "Step 18: 通过后门断言 outbox 内容与周计数",
          "mock": {
            "dependency": "Web Push",
            "strategy": "test-api",
            "config": "GET /api/test/outbox?user_id="
          },
          "method": "GET",
          "url": "{{base_url}}/api/test/outbox?user_id={{user_id}}",
          "expected_status": 200,
          "assert": [
            "body.items.length == 1",
            "body.items[0].kind == 'timing'",
            "body.items[0].status == 'delivered'",
            "body.items[0].wish_id == '{{wish_id}}'",
            "contains(body.items[0].body, '九月')",
            "contains(body.items[0].body, '滑雪')",
            "body.delivered_count_this_week == 1"
          ]
        },
        {
          "step": "Step 20: 点「我好像准备好了」",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/ready",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.state == 'wind'"]
        }
      ]
    },
    {
      "case_id": "ST-S03-02",
      "type": "normal",
      "description": "约定「多久之后再想想」",
      "covers_steps": "Step 1→8",
      "steps": [
        {
          "step": "前置：种下愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想重新开始画画" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "Step 4: after_months=3",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "after_months", "after_months": 3 },
          "expected_status": 200,
          "assert": [
            "body.state == 'brewing'",
            "body.timing.next_trigger_at >= '2026-11-30'",
            "body.timing.next_trigger_at <= '2026-12-02'"
          ]
        },
        {
          "step": "UT-S03-10: 幂等重复提交同参数",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "after_months", "after_months": 3 },
          "expected_status": 200
        }
      ]
    },
    {
      "case_id": "ST-S03-03",
      "type": "normal",
      "description": "信号类时机：调度扫不到，由对话检出疲惫后触发",
      "covers": "EX-11.1",
      "steps": [
        {
          "step": "前置：种下愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想一个人去海边待两天" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "Step 4: 约定 when_tired",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "when_tired" },
          "expected_status": 200,
          "assert": [
            "body.timing.trigger_kind == 'signal'",
            "body.timing.next_trigger_at == null"
          ]
        },
        {
          "step": "EX-11.1: 调度一轮不应命中该卡",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0"]
        },
        {
          "step": "EX-11.1: 对话中说「最近好累」",
          "mock": { "dependency": "LLM", "strategy": "mock-service", "config": "mode=fatigue" },
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/messages",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "text": "最近好累" },
          "expected_status": 200,
          "assert": ["body.intent == 'fatigue'", "body.wish.timing.next_trigger_at != null"]
        },
        {
          "step": "EX-11.1: 再调度一轮即进入 outbox",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 1"]
        }
      ]
    },
    {
      "case_id": "ST-S03-04",
      "type": "exception",
      "description": "选择「不必提醒」：状态保持 seeded，永不进入调度",
      "covers": "EX-4.1",
      "steps": [
        {
          "step": "前置：种下愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想给未来的自己写一封信" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "EX-4.1: type=none",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "none" },
          "expected_status": 200,
          "assert": [
            "body.state == 'seeded'",
            "body.timing.trigger_kind == 'none'",
            "body.timing.next_trigger_at == null",
            "contains(body.timing.label, '你说你会自己想起它')"
          ]
        },
        {
          "step": "EX-4.1: 时钟推到一年后，调度仍不命中",
          "method": "POST",
          "url": "{{base_url}}/api/test/clock",
          "body": { "now": "2027-09-01T12:00:00+08:00" },
          "expected_status": 204
        },
        {
          "step": "EX-4.1: 调度一轮",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0"]
        },
        {
          "step": "复位时钟",
          "method": "POST",
          "url": "{{base_url}}/api/test/clock",
          "body": { "now": "2026-09-01T12:00:00+08:00" },
          "expected_status": 204
        }
      ]
    },
    {
      "case_id": "ST-S03-05",
      "type": "exception",
      "description": "时机参数非法：422 且不改动原有时机",
      "covers": "EX-4.2",
      "steps": [
        {
          "step": "前置：种下并先设一个合法时机",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想去看一次日落" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "设 season=autumn 作为基线",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "season", "season": "autumn" },
          "expected_status": 200,
          "extract": { "baseline_trigger": "body.timing.next_trigger_at" }
        },
        {
          "step": "EX-4.2: type=season 缺 season",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "season" },
          "expected_status": 422,
          "assert": ["body.code == 'TIMING_INVALID'"]
        },
        {
          "step": "EX-4.2: 不存在的日期",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "month_day", "month_day": "2027-02-30" },
          "expected_status": 422,
          "assert": ["body.code == 'TIMING_INVALID'"]
        },
        {
          "step": "EX-4.2: after_months 非枚举",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "after_months", "after_months": 2 },
          "expected_status": 422
        },
        {
          "step": "EX-4.2: 原有时机未被破坏",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.timing.next_trigger_at == '{{baseline_trigger}}'",
            "body.state == 'brewing'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S03-07",
      "type": "exception",
      "description": "本周预算已满：仅前 3 条投递，第 4、5 张顺延且带 soft_deferred",
      "covers": "EX-14.1",
      "steps": [
        {
          "step": "前置：种下 5 个愿望并依次设 after_months=1（timing_set_at 递增）",
          "repeat": 5,
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "预算测试愿望 {{index}}" },
          "expected_status": 201,
          "collect": { "wish_ids": "body.wish.id" }
        },
        {
          "step": "为 5 张卡依次设时机",
          "for_each": "{{wish_ids}}",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{item}}/timing",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "type": "after_months", "after_months": 1 },
          "expected_status": 200
        },
        {
          "step": "时钟推进到 1 个月后",
          "method": "POST",
          "url": "{{base_url}}/api/test/clock",
          "body": { "now": "2026-10-02T09:00:00+08:00" },
          "expected_status": 204
        },
        {
          "step": "EX-14.1: 触发一轮调度",
          "mock": { "dependency": "Web Push", "strategy": "env-disable", "config": "仅写 outbox 并记账" },
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.delivered == 3", "body.deferred == 2"]
        },
        {
          "step": "EX-14.1: 周计数上限为 3，且无合并式通知",
          "method": "GET",
          "url": "{{base_url}}/api/test/outbox?user_id={{user_id}}",
          "expected_status": 200,
          "assert": [
            "body.delivered_count_this_week == 3",
            "count(body.items, 'status', 'delivered') == 3",
            "count(body.items, 'status', 'deferred_to_next_week') == 2",
            "all(body.items, 'kind', 'timing')",
            "!any_contains(body.items, 'body', '待处理')"
          ]
        },
        {
          "step": "EX-14.1: 被顺延的卡在列表中带 soft_deferred",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["count(body.items, 'soft_deferred', true) == 2"]
        }
      ]
    },
    {
      "case_id": "ST-S03-08",
      "type": "exception",
      "description": "同一时机被重复扫描：唯一索引拦截，不重复投递也不重复计数",
      "covers": "EX-14.2",
      "steps": [
        {
          "step": "EX-14.2: 紧接 ST-S03-07 再触发一轮",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0", "body.delivered == 0"]
        },
        {
          "step": "EX-14.2: outbox 与周计数均未变化",
          "method": "GET",
          "url": "{{base_url}}/api/test/outbox?user_id={{user_id}}",
          "expected_status": 200,
          "assert": [
            "body.delivered_count_this_week == 3",
            "body.items.length == 5"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S03-11",
      "type": "exception",
      "description": "用户选「还不是现在」：仅重算时机，无任何顺延计数",
      "covers": "EX-20.1",
      "steps": [
        {
          "step": "EX-20.1: 对已投递的卡执行 defer",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_ids[0]}}/defer",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": {},
          "expected_status": 200,
          "assert": [
            "body.state == 'brewing'",
            "body.timing.next_trigger_at >= '2026-12-30'",
            "!has(body, 'defer_count')",
            "!has(body, 'overdue_days')",
            "body.soft_deferred == false"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S03-12",
      "type": "exception",
      "description": "顺延排序键：先发用户最早定下的那件事",
      "covers": "EX-14.1 + Step 11 排序说明",
      "steps": [
        {
          "step": "新账号：按 6 个月前 / 1 个月前 / 昨天的顺序设定 3 张卡",
          "include": "fragment:three_wishes_staggered_timing",
          "expected_status": 200
        },
        {
          "step": "把周预算消耗到只剩 1 条",
          "include": "fragment:burn_budget_to_one",
          "expected_status": 200
        },
        {
          "step": "EX-14.1: 触发调度，最早设定的那张被投递",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.delivered == 1", "body.deferred == 2"]
        },
        {
          "step": "断言投递的是最早设定的卡",
          "method": "GET",
          "url": "{{base_url}}/api/test/outbox?user_id={{user_id_c}}",
          "expected_status": 200,
          "assert": ["body.items[0].wish_id == '{{oldest_wish_id}}'"]
        }
      ]
    },
    {
      "case_id": "ST-S03-15",
      "type": "boundary",
      "description": "无 push 订阅时走邮件兜底，并用邮件后门断言文案",
      "covers": "S03 Step 16 的邮件兜底分支（410 场景的同一代码路径）",
      "steps": [
        {
          "step": "新账号并绑定邮箱（邮件兜底需要收件地址）",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "token_m": "body.access_token", "user_id_m": "body.user.id" }
        },
        {
          "step": "绑定邮箱",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/link-email",
          "headers": { "Authorization": "Bearer {{token_m}}" },
          "body": { "email": "orchestration+mail@example.test", "password": "Passw0rd!" },
          "expected_status": 200
        },
        {
          "step": "种下并设 after_months=1（该账号从未注册 push 订阅）",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_m}}" },
          "body": { "source": "text", "text": "想去一次长途徒步" },
          "expected_status": 201,
          "extract": { "wish_m": "body.wish.id" }
        },
        {
          "step": "设时机",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_m}}/timing",
          "headers": { "Authorization": "Bearer {{token_m}}" },
          "body": { "type": "after_months", "after_months": 1 },
          "expected_status": 200
        },
        {
          "step": "推进时钟并触发调度",
          "method": "POST",
          "url": "{{base_url}}/api/test/clock",
          "body": { "now": "2026-10-02T09:00:00+08:00" },
          "expected_status": 204
        },
        {
          "step": "触发一轮调度",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.delivered >= 1"]
        },
        {
