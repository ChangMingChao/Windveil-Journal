{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。每个 step 的 step 字段对应时序图 Step 编号；flow 的 case_id 复用 Step 4a 的 ST-* ID，运行结果写入 logos/resources/verify/test-results.jsonl 由 openlogos verify 统一判定。",
  "scenario": "S01",
  "name": "新用户建立自己的未发生之地",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S01-onboarding-first-wish.md",
    "api": ["logos/resources/api/auth.yaml", "logos/resources/api/wishes.yaml"],
    "test_cases": "logos/resources/test/core-S01-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "LLM",
      "test_strategy": "mock-service",
      "test_config": "本地 OpenAI 兼容 mock，返回固定结构化 JSON；提供强制失败开关以覆盖降级验收条件",
      "mock_control": "PUT {{mock_base}}/_control {\"mode\":\"ok|timeout|invalid_json\"}"
    }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "确认 LLM mock 处于正常模式",
      "mock": {
        "dependency": "LLM",
        "strategy": "mock-service",
        "config": "本地 OpenAI 兼容 mock"
      },
      "method": "PUT",
      "url": "{{mock_base}}/_control",
      "body": { "mode": "ok" },
      "expected_status": 204
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "彻底删除本次编排产生的愿望，保证幂等",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/wishes/{{wish_id}}?confirm=true",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "expected_status": [204, 404],
      "optional": true
    }
  ],
  "flows": [
    {
      "case_id": "ST-S01-01",
      "type": "normal",
      "description": "完整走完温柔问题并种下第一个愿望",
      "covers_steps": "Step 1→25",
      "steps": [
        {
          "step": "Step 3: 建立匿名个人空间",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "body": { "timezone": "Asia/Shanghai" },
          "expected_status": 201,
          "extract": {
            "access_token": "body.access_token",
            "user_id": "body.user.id"
          },
          "assert": [
            "body.user.is_anonymous == true",
            "body.user.onboarded_at != null",
            "body.expires_in == 900"
          ]
        },
        {
          "step": "Step 9: 提交三题温柔问题的答案",
          "method": "POST",
          "url": "{{base_url}}/api/v1/onboarding/answers",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": {
            "answers": [
              { "question_key": "wanted_but_not_done", "answer_text": "想一个人去看海" },
              { "question_key": "what_stops_you", "answer_text": "工作太忙" },
              { "question_key": "when_would_feel_right", "answer_text": "压力小一点的时候" }
            ]
          },
          "expected_status": 204
        },
        {
          "step": "Step 13: 种下第一个愿望",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=ok，返回合法 WishUnderstanding"
          },
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "等压力没这么大的时候，想去海边待两天。" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id", "wish_version": "body.wish.version" },
          "assert": [
            "body.degraded == false",
            "body.question != null",
            "body.wish.state == 'seeded'",
            "body.wish.understanding != null",
            "body.wish.original_text == '等压力没这么大的时候，想去海边待两天。'",
            "body.wish.timing.trigger_kind == 'none'",
            "elapsed_ms < 5000"
          ]
        },
        {
          "step": "Step 22: 回答 Agent 的一句追问",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/answer",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "answer": "更像一次独处" },
          "expected_status": 200,
          "assert": ["body.pending_question == false"]
        },
        {
          "step": "Step 25: 进入未发生之地，新卡在列表中",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.items.length == 1",
            "body.items[0].id == '{{wish_id}}'",
            "body.items[0].state == 'seeded'",
            "!has(body, 'total')",
            "!has(body, 'completed_count')"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S01-02",
      "type": "normal",
      "description": "跳过温柔问题直接种下",
      "covers_steps": "Step 2→7、跳过 8→11、12→25",
      "steps": [
        {
          "step": "Step 3: 建立匿名个人空间",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "Step 9: 跳过全部问题，提交空数组",
          "method": "POST",
          "url": "{{base_url}}/api/v1/onboarding/answers",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "answers": [] },
          "expected_status": 204
        },
        {
          "step": "Step 13: 种下愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想在冬天学会滑雪" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "Step 22: 点「先不说」跳过追问",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/answer",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "skipped": true },
          "expected_status": 200,
          "assert": ["body.pending_question == true"]
        }
      ]
    },
    {
      "case_id": "ST-S01-05",
      "type": "exception",
      "description": "跳过问题后未输入任何内容即离开：onboarded_at 已写入，下次不再进首次体验",
      "covers": "EX-12.1",
      "steps": [
        {
          "step": "Step 3: 建号",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "EX-12.1: 不调 POST /wishes，直接重新读 /me",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.onboarded_at != null"]
        },
        {
          "step": "EX-12.1: 花园为空状态且无任何统计字段",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.items.length == 0",
            "body.next_cursor == null",
            "!has(body, 'total')"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S01-06",
      "type": "boundary",
      "description": "提交内容为空白或超长均被拒，且不创建记录",
      "covers": "EX-13.1",
      "steps": [
        {
          "step": "Step 3: 建号",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "EX-13.1: 纯空白被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "   " },
          "expected_status": 422,
          "assert": ["body.code == 'WISH_TEXT_INVALID'"]
        },
        {
          "step": "UT 边界：500 字通过",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "{{repeat('海', 500)}}" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "UT 边界：501 字被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "{{repeat('海', 501)}}" },
          "expected_status": 422,
          "assert": ["body.code == 'WISH_TEXT_INVALID'"]
        },
        {
          "step": "确认只创建了 1 条记录",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.items.length == 1"]
        }
      ]
    },
    {
      "case_id": "ST-S01-07",
      "type": "exception",
      "description": "LLM 超时降级：原话完整保留，标题回退原话前 20 字，仍返回 201",
      "covers": "EX-16.1",
      "steps": [
        {
          "step": "mock: 切换 LLM 为超时模式",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=timeout，延迟 6 秒（大于 LLM_TIMEOUT_SECONDS=5）"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "timeout", "delay_ms": 6000 },
          "expected_status": 204
        },
        {
          "step": "Step 3: 建号",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "Step 16: 种下愿望，LLM 超时触发降级",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "等压力没这么大的时候，想去海边待两天，最好是有日出的那种" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" },
          "assert": [
            "body.degraded == true",
            "body.question == null",
            "body.wish.understanding == null",
            "body.wish.degraded_reason == 'llm_failed'",
            "body.wish.original_text == '等压力没这么大的时候，想去海边待两天，最好是有日出的那种'",
            "body.wish.title.length == 20",
            "!contains(body.code, 'ERROR')",
            "!has(body, 'stack')"
          ]
        },
        {
          "step": "EX-16.1: 恢复 mock 后可手动补做理解",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=ok"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "ok" },
          "expected_status": 204
        },
        {
          "step": "EX-16.1: POST /understanding 补齐",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/understanding",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.degraded == false",
            "body.wish.understanding != null",
            "body.wish.original_text == '等压力没这么大的时候，想去海边待两天，最好是有日出的那种'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S01-08",
      "type": "exception",
      "description": "LLM 返回非法 JSON：对外表现与超时完全一致，绝不写入半结构化结果",
      "covers": "EX-16.2",
      "steps": [
        {
          "step": "mock: 切换 LLM 返回非 JSON 内容",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=invalid_json，返回 200 但正文为 not-json"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "invalid_json" },
          "expected_status": 204
        },
        {
          "step": "Step 3: 建号",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "Step 16→18: schema 校验失败等同不可用",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想重新开始画画" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" },
          "assert": [
            "body.degraded == true",
            "body.question == null",
            "body.wish.understanding == null",
            "body.wish.original_text == '想重新开始画画'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S01-11",
      "type": "boundary",
      "description": "认证边界：无 token 与非法 token 均 401；温柔问题字段边界",
      "covers": "UT-S01-21 / UT-S01-05 / UT-S01-06 的 HTTP 层复核",
      "steps": [
        {
          "step": "无 Authorization 头访问业务端点",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "body": { "source": "text", "text": "x" },
          "expected_status": 401,
          "assert": ["body.code == 'UNAUTHENTICATED'"]
        },
        {
          "step": "Step 3: 建号",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": { "access_token": "body.access_token" }
        },
        {
          "step": "answers 超过 10 项被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/onboarding/answers",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "answers": "{{repeat_obj({'question_key':'q','answer_text':'a'}, 11)}}" },
          "expected_status": 422
        },
        {
          "step": "answer_text 为 null 合法（该题留空）",
          "method": "POST",
          "url": "{{base_url}}/api/v1/onboarding/answers",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "answers": [{ "question_key": "q1", "answer_text": null }] },
          "expected_status": 204
        }
      ]
    }
  ],
  "not_orchestrated": [
    {
      "case_id": "ST-S01-03",
      "reason": "需要注入数据库不可用故障，无法通过 HTTP 触发；由代码级 ST 用 DB 连接 patch 覆盖"
    },
    {
      "case_id": "ST-S01-04",
      "reason": "需要强制 onboarding_answers 写入失败，同上"
    },
    { "case_id": "ST-S01-09", "reason": "[manual] 动效视觉验证" },
    { "case_id": "ST-S01-10", "reason": "[manual] 视觉与三视口目视" }
  ]
}
