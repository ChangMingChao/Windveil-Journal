{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S05",
  "name": "回看未发生之地并重新整理",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S05-browse-and-tidy.md",
    "api": ["logos/resources/api/wishes.yaml"],
    "test_cases": "logos/resources/test/core-S05-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "对象存储",
      "test_strategy": "fixed-value",
      "test_config": "本地 MinIO 真实调用，固定 bucket 与凭证",
      "note": "彻底删除链路需要真实对象存在，才能验证「先删对象后删记录」"
    },
    { "name": "LLM", "test_strategy": "mock-service", "test_config": "本地 OpenAI 兼容 mock，mode=ok" }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}",
    "fixture_photo": "tests/fixtures/sea.jpg"
  },
  "setup": [
    { "step": "setup-1", "method": "PUT", "url": "{{mock_base}}/_control", "body": { "mode": "ok" }, "expected_status": 204 },
    {
      "step": "setup-2",
      "description": "建立账号 A 与账号 B（B 用于隔离断言）",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "expected_status": 201,
      "extract": { "token_a": "body.access_token" }
    },
    {
      "step": "setup-3",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "expected_status": 201,
      "extract": { "token_b": "body.access_token" }
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/wishes/{{item.id}}?confirm=true",
      "headers": { "Authorization": "Bearer {{token_a}}" },
      "for_each": "GET {{base_url}}/api/v1/wishes -> body.items",
      "expected_status": [204, 404]
    }
  ],
  "fragments": {
    "seed_four_states": [
      {
        "step": "种下 4 个愿望，分别置于 seeded / brewing / wind / going",
        "note": "runner 依次调用 wishes → timing → ready → steps/next → done，收集 wish_ids 与各状态 id",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "repeat": 4,
        "body": { "source": "text", "text": "浏览测试愿望 {{index}}" },
        "expected_status": 201,
        "collect": { "wish_ids": "body.wish.id" }
      }
    ],
    "build_full_wish": [
      {
        "step": "上传一张照片",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/upload-url",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "kind": "image", "content_type": "image/jpeg", "size_bytes": 204800 },
        "expected_status": 201,
        "extract": { "photo_id": "body.media_id", "photo_url": "body.upload_url", "photo_public_url": "body.upload_url" }
      },
      { "step": "直传", "method": "PUT", "url": "{{photo_url}}", "body_file": "{{fixture_photo}}", "expected_status": 200 },
      {
        "step": "complete",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/{{photo_id}}/complete",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "expected_status": 204
      },
      {
        "step": "种下带照片的愿望",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "source": "text", "text": "删除链路测试愿望", "photo_media_ids": ["{{photo_id}}"] },
        "expected_status": 201,
        "extract": { "wish_id": "body.wish.id" }
      },
      {
        "step": "设时机产生 pending 提醒",
        "method": "PUT",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "type": "season", "season": "winter" },
        "expected_status": 200
      },
      {
        "step": "ready + 取步骤 + done，产生步骤与时间线",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/ready",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "expected_status": 200,
        "extract": { "version": "body.version" }
      },
      {
        "step": "取步骤",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/steps/next",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "expected_status": 200,
        "extract": { "step_id": "body.step.id" }
      },
      {
        "step": "done",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/steps/{{step_id}}/done",
        "headers": { "Authorization": "Bearer {{token_a}}", "If-Match": "{{version}}" },
        "expected_status": 200,
        "extract": { "version": "body.wish.version" }
      },
      {
        "step": "一条对话，产生 wish_messages",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/messages",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "text": "先这样吧" },
        "expected_status": 200
      },
      {
        "step": "改一次标题，产生 wish_amendments",
        "method": "PATCH",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "title": "删除链路测试（已改名）" },
        "expected_status": 200
      }
    ],
    "advance_to_happened": [
      {
        "step": "种下",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "source": "text", "text": "终态测试愿望" },
        "expected_status": 201,
        "extract": { "wish_id": "body.wish.id" }
      },
      {
        "step": "标记已发生",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "body": { "happened_from": "2026-08-20" },
        "expected_status": 201,
        "extract": { "memory_id": "body.memory.id" }
      },
      {
        "step": "收进书里",
        "method": "POST",
        "url": "{{base_url}}/api/v1/memories/{{memory_id}}/publish",
        "headers": { "Authorization": "Bearer {{token_a}}" },
        "expected_status": 200
      }
    ]
  },
  "flows": [
    {
      "case_id": "ST-S05-01",
      "type": "normal",
      "description": "按状态浏览并深链，响应不含任何统计字段",
      "covers_steps": "Step 1→12",
      "steps": [
        { "step": "前置：造 4 种状态的卡", "include": "fragment:seed_four_states", "expected_status": 201 },
        {
          "step": "Step 2: 默认列表按 seeded_at 倒序",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": [
            "body.items.length == 4",
            "sorted_desc(body.items, 'seeded_at')",
            "keys(body) == ['items', 'next_cursor']",
            "!has(body, 'total')",
            "!has(body, 'completed_count')",
            "!has(body, 'overdue_count')"
          ]
        },
        {
          "step": "Step 8: 按状态筛选",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?state=brewing",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": ["all(body.items, 'state', 'brewing')"]
        },
        {
          "step": "每张卡都带 timing.label 与三重状态表达所需字段",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": [
            "all_have(body.items, 'timing.label')",
            "all_have(body.items, 'state')",
            "all_have(body.items, 'version')"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S05-03",
      "type": "normal",
      "description": "游标分页无重叠无遗漏",
      "covers_steps": "Step 2→5",
      "steps": [
        {
          "step": "造 30 张卡",
          "repeat": 30,
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "source": "text", "text": "分页测试 {{index}}" },
          "expected_status": 201
        },
        {
          "step": "第一页",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?limit=20",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "extract": { "cursor": "body.next_cursor", "page1_ids": "body.items[*].id" },
          "assert": ["body.items.length == 20", "body.next_cursor != null"]
        },
        {
          "step": "第二页",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?limit=20&cursor={{cursor}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": [
            "no_intersection(body.items[*].id, {{page1_ids}})",
            "body.next_cursor == null"
          ]
        },
        {
          "step": "UT-S05-03: limit 边界 0 与 51 被拒",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?limit=51",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 422
        }
      ]
    },
    {
      "case_id": "ST-S05-04",
      "type": "normal",
      "description": "安静放下：清空待投递提醒、保留原话与种下时间、文案无禁用词",
      "covers_steps": "Step 15→22",
      "steps": [
        {
          "step": "前置：种下并设时机（产生 pending 提醒的前提）",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "source": "text", "text": "想去看一次海上日出" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id", "seeded_at": "body.wish.seeded_at", "original": "body.wish.original_text" }
        },
        {
          "step": "设时机",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "type": "season", "season": "winter" },
          "expected_status": 200
        },
        {
          "step": "Step 17: 安静放下",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/let-go",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": [
            "body.state == 'let_go'",
            "body.timing.next_trigger_at == null",
            "body.seeded_at == '{{seeded_at}}'",
            "body.original_text == '{{original}}'",
            "!contains(json(body), '失败')",
            "!contains(json(body), '放弃')",
            "!contains(json(body), '未完成')"
          ]
        },
        {
          "step": "Step 22: 出现在「安静放下」筛选中",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?state=let_go",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": ["any(body.items, 'id', '{{wish_id}}')"]
        },
        {
          "step": "Step 19: 待投递提醒已清空",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0"]
        }
      ]
    },
    {
      "case_id": "ST-S05-05",
      "type": "normal",
      "description": "改一改它：标题更新但 seeded_at 与原话不变，留下修订快照",
      "covers_steps": "Step 15",
      "steps": [
        {
          "step": "前置：种下",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "source": "text", "text": "想在冬天学会滑雪" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id", "seeded_at": "body.wish.seeded_at" }
        },
        {
          "step": "Step 15: 改标题",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "title": "和朋友学会滑雪" },
          "expected_status": 200,
          "assert": [
            "body.title == '和朋友学会滑雪'",
            "body.seeded_at == '{{seeded_at}}'",
            "body.original_text == '想在冬天学会滑雪'",
            "body.amended_from == '想在冬天学会滑雪'",
            "!has(body, 'amend_count')"
          ]
        },
        {
          "step": "UT-S05-07: 空 body 被拒",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": {},
          "expected_status": 422
        },
        {
          "step": "UT-S05-08: title 61 字被拒",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "title": "{{repeat('滑', 61)}}" },
          "expected_status": 422
        }
      ]
    },
    {
      "case_id": "ST-S05-06",
      "type": "normal",
      "description": "彻底删除完整链路：对象与全部子表清空",
      "covers_steps": "Step 23→32",
      "steps": [
        {
          "step": "前置：造一个含照片、步骤、对话、修订、提醒的愿望",
          "include": "fragment:build_full_wish",
          "expected_status": 200
        },
        {
          "step": "Step 25: 彻底删除",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}?confirm=true",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 204
        },
        {
          "step": "Step 32: 详情返回 404",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 404,
          "assert": ["body.code == 'WISH_NOT_FOUND'"]
        },
        {
          "step": "Step 28: 照片对象已从存储删除",
          "method": "GET",
          "url": "{{photo_public_url}}",
          "expected_status": [403, 404]
        },
        {
          "step": "Step 30: 提醒队列不再命中该愿望",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0"]
        }
      ]
    },
    {
      "case_id": "ST-S05-07",
      "type": "exception",
      "description": "游标失效返回 400",
      "covers": "EX-2.1",
      "steps": [
        {
          "step": "EX-2.1: 非法游标",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?cursor=!!!not-a-cursor",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 400,
          "assert": ["body.code == 'CURSOR_INVALID'"]
        }
      ]
    },
    {
      "case_id": "ST-S05-08",
      "type": "exception",
      "description": "访问他人的愿望返回 404 而非 403",
      "covers": "EX-3.1",
      "steps": [
        {
          "step": "账号 A 种下一个愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "source": "text", "text": "只属于 A 的愿望" },
          "expected_status": 201,
          "extract": { "wish_a": "body.wish.id" }
        },
        {
          "step": "EX-3.1: 账号 B 读取 A 的愿望",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_a}}",
          "headers": { "Authorization": "Bearer {{token_b}}" },
          "expected_status": 404,
          "assert": ["body.code == 'WISH_NOT_FOUND'", "!contains(json(body), 'forbidden')"]
        },
        {
          "step": "EX-3.1: 账号 B 尝试修改 A 的愿望",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/wishes/{{wish_a}}",
          "headers": { "Authorization": "Bearer {{token_b}}" },
          "body": { "title": "越权改写" },
          "expected_status": 404
        },
        {
          "step": "EX-3.1: 账号 B 尝试删除 A 的愿望",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/wishes/{{wish_a}}?confirm=true",
          "headers": { "Authorization": "Bearer {{token_b}}" },
          "expected_status": 404
        },
        {
          "step": "EX-3.1: A 的愿望完好无损",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_a}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": ["body.title != '越权改写'"]
        }
      ]
    },
    {
      "case_id": "ST-S05-09",
      "type": "exception",
      "description": "花园为空",
      "covers": "EX-6.1",
      "steps": [
        {
          "step": "EX-6.1: 新账号 B 的空花园",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_b}}" },
          "expected_status": 200,
          "assert": [
            "body.items.length == 0",
            "body.next_cursor == null",
            "keys(body) == ['items', 'next_cursor']"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S05-10",
      "type": "exception",
      "description": "某状态无卡片时不自动回退为 all",
      "covers": "EX-9.1",
      "steps": [
        {
          "step": "EX-9.1: 账号 B 无 going 卡",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes?state=going",
          "headers": { "Authorization": "Bearer {{token_b}}" },
          "expected_status": 200,
          "assert": ["body.items.length == 0"]
        }
      ]
    },
    {
      "case_id": "ST-S05-11",
      "type": "exception",
      "description": "在 happened 终态尝试放下返回 409",
      "covers": "EX-17.1",
      "steps": [
        {
          "step": "前置：把一个愿望推到 happened",
          "include": "fragment:advance_to_happened",
          "expected_status": 200
        },
        {
          "step": "EX-17.1: 终态放下被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/let-go",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 409,
          "assert": ["body.code == 'STATE_TRANSITION_NOT_ALLOWED'"]
        },
        {
          "step": "EX-17.1: 数据未被改动",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200,
          "assert": ["body.state == 'happened'"]
        }
      ]
    },
    {
      "case_id": "ST-S05-12",
      "type": "exception",
      "description": "彻底删除缺少确认参数",
      "covers": "EX-25.1",
      "steps": [
        {
          "step": "前置：种下",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "body": { "source": "text", "text": "确认参数测试" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "EX-25.1: 不带 confirm",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 400,
          "assert": ["body.code == 'CONFIRMATION_REQUIRED'"]
        },
        {
          "step": "EX-25.1: confirm=false 同样被拒",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}?confirm=false",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 400
        },
        {
          "step": "EX-25.1: 记录仍存在",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{token_a}}" },
          "expected_status": 200
        }
      ]
    },
    {
      "case_id": "ST-S05-14",
      "type": "exception",
