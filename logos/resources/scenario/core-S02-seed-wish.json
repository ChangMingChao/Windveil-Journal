{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S02",
  "name": "随手种下一个愿望并被理解",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S02-seed-wish.md",
    "api": [
      "logos/resources/api/media.yaml",
      "logos/resources/api/wishes.yaml"
    ],
    "test_cases": "logos/resources/test/core-S02-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "LLM",
      "test_strategy": "mock-service",
      "test_config": "本地 OpenAI 兼容 mock，返回固定结构化 JSON；提供强制失败开关",
      "mock_control": "PUT {{mock_base}}/_control"
    },
    {
      "name": "语音转写 ASR",
      "test_strategy": "mock-service",
      "test_config": "同 LLM mock 服务；失败模式用于验证保留原始音频与重试转写",
      "mock_control": "PUT {{mock_base}}/_control_asr"
    },
    {
      "name": "对象存储",
      "test_strategy": "fixed-value",
      "test_config": "本地 MinIO 真实调用，固定 bucket 与凭证；预签名 URL 正确性本身是被测行为，不 mock",
      "note": "架构声明的策略为 fixed-value，但其语义是「固定凭证 + 真实调用」，与 Skill 中 fixed-value 的「不发起实际请求」不同。此处按架构声明消费，编排仍发起真实 PUT；语义不一致已在 core-00-orchestration-index.json 中登记待确认。"
    }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}",
    "fixture_audio": "tests/fixtures/smoke-18s.webm",
    "fixture_photo": "tests/fixtures/sea.jpg"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "mock 置为正常模式",
      "method": "PUT",
      "url": "{{mock_base}}/_control",
      "body": {
        "mode": "ok"
      },
      "expected_status": 204
    },
    {
      "step": "setup-2",
      "description": "建立匿名账号供全部 flow 复用",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "expected_status": 201,
      "extract": {
        "access_token": "body.access_token"
      }
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "清理本次编排创建的全部愿望",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/wishes/{{item.id}}?confirm=true",
      "headers": {
        "Authorization": "Bearer {{access_token}}"
      },
      "for_each": "GET {{base_url}}/api/v1/wishes -> body.items",
      "expected_status": [
        204,
        404
      ]
    }
  ],
  "flows": [
    {
      "case_id": "ST-S02-01",
      "type": "normal",
      "description": "语音路径完整种下并跳过追问",
      "covers_steps": "Step 1→27",
      "steps": [
        {
          "step": "Step 3: 申请音频预签名 PUT",
          "mock": {
            "dependency": "对象存储",
            "strategy": "fixed-value",
            "config": "本地 MinIO 固定 bucket 与凭证"
          },
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 184320
          },
          "expected_status": 201,
          "extract": {
            "media_id": "body.media_id",
            "upload_url": "body.upload_url"
          },
          "assert": [
            "body.expires_at != null",
            "!contains(body.upload_url, '/api/v1/')"
          ]
        },
        {
          "step": "Step 5: 直传音频到对象存储（不经过 API）",
          "method": "PUT",
          "url": "{{upload_url}}",
          "body_file": "{{fixture_audio}}",
          "expected_status": 200
        },
        {
          "step": "Step 7: 声明上传完成并由服务端校验",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/{{media_id}}/complete",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 204
        },
        {
          "step": "Step 12: 以语音种下愿望",
          "mock": {
            "dependency": "语音转写 ASR",
            "strategy": "mock-service",
            "config": "mode=ok，返回固定转写文本"
          },
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "voice",
            "media_id": "{{media_id}}"
          },
          "expected_status": 201,
          "extract": {
            "wish_id": "body.wish.id"
          },
          "assert": [
            "body.degraded == false",
            "body.wish.source == 'voice'",
            "body.wish.audio_media_id == '{{media_id}}'",
            "body.wish.original_text != null",
            "body.wish.understanding != null",
            "body.question != null"
          ]
        },
        {
          "step": "Step 24: 点「先不说」",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/answer",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "skipped": true
          },
          "expected_status": 200,
          "assert": [
            "body.pending_question == true",
            "body.audio_media_id == '{{media_id}}'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-02",
      "type": "normal",
      "description": "文字路径一句话种下，隐含条件被提取",
      "covers_steps": "Step 12→27",
      "steps": [
        {
          "step": "Step 12: 文字种下",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=ok"
          },
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "text",
            "text": "想在冬天学会滑雪"
          },
          "expected_status": 201,
          "extract": {
            "wish_id": "body.wish.id"
          },
          "assert": [
            "body.wish.understanding.kind == 'future_wish'",
            "body.wish.understanding.conditions.season == 'winter'",
            "body.wish.understanding.smallest_step != null",
            "body.question != null",
            "elapsed_ms < 5000"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-03",
      "type": "normal",
      "description": "附加照片种下",
      "covers_steps": "Step 3→11（image）+ Step 12→27",
      "steps": [
        {
          "step": "Step 3: 申请图片预签名",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "image",
            "content_type": "image/jpeg",
            "size_bytes": 204800
          },
          "expected_status": 201,
          "extract": {
            "photo_id": "body.media_id",
            "photo_url": "body.upload_url"
          }
        },
        {
          "step": "Step 5: 直传照片",
          "method": "PUT",
          "url": "{{photo_url}}",
          "body_file": "{{fixture_photo}}",
          "expected_status": 200
        },
        {
          "step": "Step 7: 完成校验",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/{{photo_id}}/complete",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 204
        },
        {
          "step": "Step 12: 带照片种下",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "text",
            "text": "想去看一次海上日出",
            "photo_media_ids": [
              "{{photo_id}}"
            ]
          },
          "expected_status": 201,
          "extract": {
            "wish_id": "body.wish.id"
          },
          "assert": [
            "body.wish.photo_media_ids.length == 1"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-04",
      "type": "exception",
      "description": "预签名被篡改导致直传失败：不创建愿望，media 停留 pending",
      "covers": "EX-5.1",
      "steps": [
        {
          "step": "Step 3: 申请预签名",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 184320
          },
          "expected_status": 201,
          "extract": {
            "media_id": "body.media_id",
            "upload_url": "body.upload_url"
          }
        },
        {
          "step": "EX-5.1: 用被篡改签名的 URL 直传",
          "method": "PUT",
          "url": "{{upload_url}}&X-Amz-Signature=tampered",
          "body_file": "{{fixture_audio}}",
          "expected_status": [
            403,
            400
          ]
        },
        {
          "step": "EX-5.1: 未 complete 直接种下应被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "voice",
            "media_id": "{{media_id}}"
          },
          "expected_status": 422,
          "assert": [
            "body.code == 'MEDIA_INVALID'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-05",
      "type": "exception",
      "description": "媒体校验不通过：对象被删、status 置 rejected",
      "covers": "EX-8.1",
      "steps": [
        {
          "step": "EX-8.1: 声明 1MB 但实际上传 12MB",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 1048576
          },
          "expected_status": 201,
          "extract": {
            "media_id": "body.media_id",
            "upload_url": "body.upload_url"
          }
        },
        {
          "step": "上传超限文件",
          "method": "PUT",
          "url": "{{upload_url}}",
          "body_file": "tests/fixtures/oversize-12mb.webm",
          "expected_status": [
            200,
            413
          ]
        },
        {
          "step": "EX-8.1: complete 校验不通过",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/{{media_id}}/complete",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 422,
          "assert": [
            "body.code == 'MEDIA_INVALID'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-06",
      "type": "exception",
      "description": "转写失败：标题回退、原话为空、音频保留、可重试成功",
      "covers": "EX-15.1",
      "steps": [
        {
          "step": "mock: ASR 置为 500",
          "mock": {
            "dependency": "语音转写 ASR",
            "strategy": "mock-service",
            "config": "mode=error_500"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control_asr",
          "body": {
            "mode": "error_500"
          },
          "expected_status": 204
        },
        {
          "step": "Step 3→11: 上传音频",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 184320
          },
          "expected_status": 201,
          "extract": {
            "media_id": "body.media_id",
            "upload_url": "body.upload_url"
          }
        },
        {
          "step": "直传并 complete",
          "method": "PUT",
          "url": "{{upload_url}}",
          "body_file": "{{fixture_audio}}",
          "expected_status": 200
        },
        {
          "step": "complete",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/{{media_id}}/complete",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 204
        },
        {
          "step": "Step 15: 转写失败但仍创建愿望",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "voice",
            "media_id": "{{media_id}}"
          },
          "expected_status": 201,
          "extract": {
            "wish_id": "body.wish.id"
          },
          "assert": [
            "body.wish.title == '一段还没被读懂的话'",
            "body.wish.original_text == null",
            "body.wish.degraded_reason == 'asr_failed'",
            "body.wish.audio_media_id == '{{media_id}}'"
          ]
        },
        {
          "step": "mock: ASR 恢复",
          "method": "PUT",
          "url": "{{mock_base}}/_control_asr",
          "body": {
            "mode": "ok"
          },
          "expected_status": 204
        },
        {
          "step": "EX-15.1: 重试转写成功",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/transcription",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 200,
          "assert": [
            "body.wish.original_text != null",
            "body.wish.degraded_reason == null"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-07",
      "type": "exception",
      "description": "转写返回空文本：degraded_reason 区分为 asr_empty",
      "covers": "EX-15.2",
      "steps": [
        {
          "step": "mock: ASR 返回空串",
          "mock": {
            "dependency": "语音转写 ASR",
            "strategy": "mock-service",
            "config": "mode=empty_text"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control_asr",
          "body": {
            "mode": "empty_text"
          },
          "expected_status": 204
        },
        {
          "step": "上传音频并种下（复用 upload 三步）",
          "include": "fragment:upload_audio",
          "expected_status": 204
        },
        {
          "step": "EX-15.2: 空转写走 asr_empty 分支",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "voice",
            "media_id": "{{media_id}}"
          },
          "expected_status": 201,
          "assert": [
            "body.wish.degraded_reason == 'asr_empty'",
            "body.wish.original_text == null",
            "body.wish.audio_media_id == '{{media_id}}'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-08",
      "type": "exception",
      "description": "LLM 理解失败：原话完整、可补理解",
      "covers": "EX-18.1",
      "steps": [
        {
          "step": "mock: LLM 超时",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=timeout"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": {
            "mode": "timeout",
            "delay_ms": 6000
          },
          "expected_status": 204
        },
        {
          "step": "EX-18.1: 文字种下降级",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "text",
            "text": "想带父母去一次南方"
          },
          "expected_status": 201,
          "assert": [
            "body.degraded == true",
            "body.wish.original_text == '想带父母去一次南方'",
            "body.wish.understanding == null"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-09",
      "type": "exception",
      "description": "输入是当下日程：以询问方式确认，不丢弃内容；选 delete 后硬删",
      "covers": "EX-18.2",
      "steps": [
        {
          "step": "mock: LLM 返回 near_term_todo",
          "mock": {
            "dependency": "LLM",
            "strategy": "mock-service",
            "config": "mode=near_term_todo"
          },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": {
            "mode": "near_term_todo"
          },
          "expected_status": 204
        },
        {
          "step": "EX-18.2: 提交当下日程",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "text",
            "text": "今天下午 3 点开会"
          },
          "expected_status": 201,
          "extract": {
            "wish_id": "body.wish.id"
          },
          "assert": [
            "body.wish.understanding.kind == 'near_term_todo'",
            "contains(body.question, '未来')",
            "body.actions == ['keep_as_future', 'delete']",
            "!contains(body.question, '格式错误')"
          ]
        },
        {
          "step": "EX-18.2: 用户选择「就当成一件未来的事」",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/answer",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "action": "keep_as_future"
          },
          "expected_status": 200,
          "assert": [
            "body.state == 'seeded'"
          ]
        },
        {
          "step": "EX-18.2: 另一条分支——选择删掉它",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}?confirm=true",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 204
        },
        {
          "step": "EX-18.2: 确认已硬删",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "expected_status": 404,
          "assert": [
            "body.code == 'WISH_NOT_FOUND'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-14",
      "type": "boundary",
      "description": "媒体字段边界与跨用户引用",
      "covers": "UT-S02-01~05、UT-S02-09~11 的编排层复核",
      "steps": [
        {
          "step": "kind 与 content_type 不匹配",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "image/png",
            "size_bytes": 1024
          },
          "expected_status": 422,
          "assert": [
            "body.code == 'MEDIA_INVALID'"
          ]
        },
        {
          "step": "音频上限边界：10485760 通过",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 10485760
          },
          "expected_status": 201
        },
        {
          "step": "音频上限边界：10485761 被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/upload-url",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "kind": "audio",
            "content_type": "audio/webm",
            "size_bytes": 10485761
          },
          "expected_status": 422
        },
        {
          "step": "photo_media_ids 边界：10 个被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": {
            "Authorization": "Bearer {{access_token}}"
          },
          "body": {
            "source": "text",
            "text": "边界测试",
            "photo_media_ids": "{{uuid_list(10)}}"
          },
          "expected_status": 422
        },
        {
          "step": "另建账号 B，引用 A 的 media 返回 404",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/anonymous",
          "expected_status": 201,
          "extract": {
            "token_b": "body.access_token"
          }
        },
        {
          "step": "UT-S02-11: 跨用户引用媒体",
          "method": "POST",
          "url": "{{base_url}}/api/v1/media/{{media_id}}/complete",
          "headers": {
            "Authorization": "Bearer {{token_b}}"
          },
          "expected_status": 404,
          "assert": [
            "body.code == 'MEDIA_NOT_FOUND'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S02-16",
      "type": "normal",
