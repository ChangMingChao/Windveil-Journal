{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S06",
  "name": "把发生过的事写成一页记忆",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S06-write-memory-page.md",
    "api": ["logos/resources/api/memories.yaml", "logos/resources/api/wishes.yaml"],
    "test_cases": "logos/resources/test/core-S06-test-cases.md"
  },
  "external_dependencies": [
    { "name": "LLM", "test_strategy": "mock-service", "test_config": "本地 OpenAI 兼容 mock；模式含 ok / timeout" },
    { "name": "系统时钟", "test_strategy": "fixed-value", "test_config": "POST /api/test/clock，用于未来日期与早于种下日期的断言" },
    { "name": "对象存储", "test_strategy": "fixed-value", "test_config": "本地 MinIO 真实调用，固定 bucket 与凭证" },
    { "name": "Web Push", "test_strategy": "env-disable", "test_config": "仅写 reminder_outbox；用于断言标记已发生后提醒停止" }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}",
    "fixture_photo": "tests/fixtures/sea.jpg"
  },
  "setup": [
    { "step": "setup-1", "method": "POST", "url": "{{base_url}}/api/test/clock", "body": { "now": "2026-11-01T12:00:00+08:00" }, "expected_status": 204 },
    { "step": "setup-2", "method": "PUT", "url": "{{mock_base}}/_control", "body": { "mode": "ok" }, "expected_status": 204 },
    {
      "step": "setup-3",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "expected_status": 201,
      "extract": { "access_token": "body.access_token", "user_id": "body.user.id" }
    }
  ],
  "teardown": [
    { "step": "teardown-1", "method": "POST", "url": "{{base_url}}/api/test/clock", "body": { "now": null }, "expected_status": 204 },
    {
      "step": "teardown-2",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/wishes/{{item.id}}?confirm=true",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "for_each": "GET {{base_url}}/api/v1/wishes -> body.items",
      "expected_status": [204, 404]
    }
  ],
  "fragments": {
    "wish_in_going_with_timeline": [
      {
        "step": "种下（时钟已在 2026-11-01，seeded_at 即该时刻）",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "source": "text", "text": "想一个人去海边待两天" },
        "expected_status": 201,
        "extract": { "wish_id": "body.wish.id", "seeded_at": "body.wish.seeded_at" }
      },
      {
        "step": "设时机，产生 pending 提醒",
        "method": "PUT",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "type": "season", "season": "winter" },
        "expected_status": 200
      },
      {
        "step": "ready",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/ready",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "expected_status": 200,
        "extract": { "version": "body.version" }
      },
      {
        "step": "取步骤",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/steps/next",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "expected_status": 200,
        "extract": { "step_id": "body.step.id" }
      },
      {
        "step": "done，进入 going 并留下 1 条时间线",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/steps/{{step_id}}/done",
        "headers": { "Authorization": "Bearer {{access_token}}", "If-Match": "{{version}}" },
        "expected_status": 200
      }
    ],
    "upload_two_photos": [
      {
        "step": "上传照片 1",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/upload-url",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "kind": "image", "content_type": "image/jpeg", "size_bytes": 204800 },
        "expected_status": 201,
        "extract": { "photo_1": "body.media_id", "u1": "body.upload_url" }
      },
      { "step": "直传 1", "method": "PUT", "url": "{{u1}}", "body_file": "{{fixture_photo}}", "expected_status": 200 },
      {
        "step": "complete 1",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/{{photo_1}}/complete",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "expected_status": 204
      },
      {
        "step": "上传照片 2",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/upload-url",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "kind": "image", "content_type": "image/jpeg", "size_bytes": 204800 },
        "expected_status": 201,
        "extract": { "photo_2": "body.media_id", "u2": "body.upload_url" }
      },
      { "step": "直传 2", "method": "PUT", "url": "{{u2}}", "body_file": "{{fixture_photo}}", "expected_status": 200 },
      {
        "step": "complete 2",
        "method": "POST",
        "url": "{{base_url}}/api/v1/media/{{photo_2}}/complete",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "expected_status": 204
      }
    ],
    "plain_draft": [
      {
        "step": "种下一个愿望",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "source": "text", "text": "想去看一次雪山" },
        "expected_status": 201,
        "extract": { "wish_id": "body.wish.id" }
      },
      {
        "step": "标记已发生生成草稿",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "happened_from": "2026-10-10" },
        "expected_status": 201,
        "extract": { "memory_id": "body.memory.id" }
      }
    ],
    "degraded_draft": [
      {
        "step": "mock: LLM 超时",
        "method": "PUT",
        "url": "{{mock_base}}/_control",
        "body": { "mode": "timeout", "delay_ms": 6000 },
        "expected_status": 204
      },
      {
        "step": "种下并推进到 going（保证有时间线，便于验证 process 被补全）",
        "include": "wish_in_going_with_timeline"
      },
      {
        "step": "标记已发生（草拟失败）",
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "happened_from": "2026-10-12" },
        "expected_status": 201,
        "extract": { "memory_id": "body.memory.id" }
      }
    ],
    "three_published_memories": [
      {
        "step": "按 10-17 / 09-05 / 08-01 造 3 个已发布记忆页",
        "note": "runner 循环执行 wishes → happened → publish 三步；日期由列表提供",
        "for_each": ["2026-10-17", "2026-09-05", "2026-08-01"],
        "method": "POST",
        "url": "{{base_url}}/api/v1/wishes",
        "headers": { "Authorization": "Bearer {{access_token}}" },
        "body": { "source": "text", "text": "书架排序测试 {{item}}" },
        "expected_status": 201
      }
    ]
  },
  "flows": [
    {
      "case_id": "ST-S06-01",
      "type": "normal",
      "description": "生成并补充一页记忆，收进书里后愿望进入终态且不再接收提醒",
      "covers_steps": "Step 1→20",
      "steps": [
        { "step": "前置：going 状态且有时间线", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "Step 3: 标记已发生（区间）",
          "mock": { "dependency": "LLM", "strategy": "mock-service", "config": "mode=ok" },
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-17", "happened_to": "2026-10-18" },
          "expected_status": 201,
          "extract": { "memory_id": "body.memory.id" },
          "assert": [
            "body.degraded == false",
            "body.warning == null",
            "body.memory.status == 'draft'",
            "body.memory.title != null",
            "body.memory.cause != null",
            "body.memory.process != null",
            "elapsed_ms < 5000"
          ]
        },
        {
          "step": "Step 6: 提醒已停但状态仍为 going",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.state == 'going'", "body.timing.next_trigger_at == null"]
        },
        {
          "step": "Step 6: 调度一轮确认不再入箱",
          "mock": { "dependency": "Web Push", "strategy": "env-disable", "config": "仅写 outbox" },
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200,
          "assert": ["body.enqueued == 0"]
        },
        {
          "step": "Step 11→12: 上传 2 张照片并补充心情与一句话",
          "include": "fragment:upload_two_photos",
          "expected_status": 204
        },
        {
          "step": "Step 12: PATCH 保存",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": {
            "mood": "relieved",
            "last_line": "原来我不是不想努力，只是需要喘口气。",
            "photo_media_ids": ["{{photo_1}}", "{{photo_2}}"]
          },
          "expected_status": 200,
          "assert": [
            "body.mood == 'relieved'",
            "body.photo_media_ids.length == 2",
            "body.last_line != null"
          ]
        },
        {
          "step": "Step 16: 收进书里",
          "method": "POST",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}/publish",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.memory.status == 'published'", "body.memory.published_at != null"]
        },
        {
          "step": "Step 17: 愿望进入 happened 终态",
          "method": "GET",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.state == 'happened'"]
        },
        {
          "step": "Step 20: 出现在书架且 lived_pages 计数正确",
          "method": "GET",
          "url": "{{base_url}}/api/v1/memories",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.lived_pages == 1",
            "body.items.length == 1",
            "body.items[0].id == '{{memory_id}}'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S06-02",
      "type": "normal",
      "description": "跳过全部补充内容直接发布，无非空校验",
      "covers_steps": "Step 1→10 + 15→20",
      "steps": [
        { "step": "前置：going 愿望", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "标记已发生",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-20" },
          "expected_status": 201,
          "extract": { "memory_id": "body.memory.id" }
        },
        {
          "step": "UT-S06-10: 把可选字段全部置 null 仍可保存",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "mood": null, "last_line": null, "voice_media_id": null },
          "expected_status": 200
        },
        {
          "step": "直接发布",
          "method": "POST",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}/publish",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.memory.status == 'published'"]
        },
        {
          "step": "发布后仍可继续补充",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "last_line": "后来才想起要写下这句" },
          "expected_status": 200
        }
      ]
    },
    {
      "case_id": "ST-S06-03",
      "type": "normal",
      "description": "单日发生：happened_to 为 null",
      "covers_steps": "Step 2→10",
      "steps": [
        { "step": "前置：going 愿望", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "单日提交",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-17" },
          "expected_status": 201,
          "assert": ["body.memory.happened_to == null"]
        }
      ]
    },
    {
      "case_id": "ST-S06-04",
      "type": "normal",
      "description": "书架按发生时间倒序，无封面时 cover_media_id 为 null",
      "covers_steps": "Step 20",
      "steps": [
        {
          "step": "造 3 个已发布记忆页，发生日期分别为 10-17 / 09-05 / 08-01",
          "include": "fragment:three_published_memories",
          "expected_status": 200
        },
        {
          "step": "Step 20: 书架倒序",
          "method": "GET",
          "url": "{{base_url}}/api/v1/memories",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.lived_pages == 3",
            "sorted_desc(body.items, 'happened_from')",
            "body.items[0].happened_from == '2026-10-17'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S06-05",
      "type": "exception",
      "description": "发生日期早于种下日期：返回 warning 而非错误，确认后写入注记",
      "covers": "EX-3.1",
      "steps": [
        { "step": "前置：going 愿望（seeded_at = 2026-11-01）", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "EX-3.1: 首次提交 2026-07-12，不带 ack",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-07-12" },
          "expected_status": 201,
          "extract": { "memory_id": "body.memory.id" },
          "assert": [
            "body.warning.code == 'HAPPENED_BEFORE_SEEDED'",
            "body.memory.note_before_seeded == false",
            "contains(body.warning.message, '更早发生')"
          ]
        },
        {
          "step": "EX-3.1: 用户确认后重提，带 ack",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-07-12", "acknowledged_before_seeded": true },
          "expected_status": 201,
          "assert": [
            "body.warning == null",
            "body.memory.note_before_seeded == true",
            "body.memory.id == '{{memory_id}}'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S06-06",
      "type": "exception",
      "description": "发生日期在未来被硬拦",
      "covers": "EX-3.2",
      "steps": [
        { "step": "前置：going 愿望", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "EX-3.2: 未来日期",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-12-01" },
          "expected_status": 422,
          "assert": ["body.code == 'HAPPENED_DATE_IN_FUTURE'"]
        },
        {
          "step": "UT-S06-05: 今天为边界，应通过",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-11-01" },
          "expected_status": 201
        }
      ]
    },
    {
      "case_id": "ST-S06-07",
      "type": "exception",
      "description": "区间倒置被拒",
      "covers": "EX-3.3",
      "steps": [
        { "step": "前置：going 愿望", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "EX-3.3: to < from",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-18", "happened_to": "2026-10-17" },
          "expected_status": 422,
          "assert": ["body.code == 'HAPPENED_RANGE_INVALID'"]
        },
        {
          "step": "UT-S06-07: from == to 通过",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-17", "happened_to": "2026-10-17" },
          "expected_status": 201
        }
      ]
    },
    {
      "case_id": "ST-S06-08",
      "type": "exception",
      "description": "未经历约定路径直接标记已发生：process 为空且不拦截",
      "covers": "EX-4.1",
      "steps": [
        {
          "step": "前置：仅种下，不设时机不推进",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "source": "text", "text": "想去看一次银河" },
          "expected_status": 201,
          "extract": { "wish_id": "body.wish.id" }
        },
        {
          "step": "EX-4.1: seeded 状态直接标记已发生",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-05" },
          "expected_status": 201,
          "extract": { "memory_id": "body.memory.id" },
          "assert": [
            "body.memory.process == null",
            "body.memory.cause != null",
            "!contains(json(body), '请先完成')"
          ]
        },
        {
          "step": "EX-4.1: 仍可正常发布",
          "method": "POST",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}/publish",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200
        }
      ]
    },
    {
      "case_id": "ST-S06-09",
      "type": "exception",
      "description": "LLM 草拟失败：标题回退原标题、起因回退原话引用、process 为空",
      "covers": "EX-7.1",
      "steps": [
        { "step": "前置：going 愿望", "include": "fragment:wish_in_going_with_timeline", "expected_status": 200 },
        {
          "step": "mock: LLM 超时",
          "mock": { "dependency": "LLM", "strategy": "mock-service", "config": "mode=timeout" },
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "timeout", "delay_ms": 6000 },
          "expected_status": 204
        },
        {
          "step": "EX-7.1: 草拟失败仍返回 201",
          "method": "POST",
          "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/happened",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "happened_from": "2026-10-17" },
          "expected_status": 201,
          "extract": { "memory_id": "body.memory.id" },
          "assert": [
            "body.degraded == true",
            "body.memory.process == null",
            "contains(body.memory.cause, '想一个人去海边待两天')"
          ]
        },
        {
          "step": "EX-7.1: 降级不阻塞发布",
          "method": "POST",
          "url": "{{base_url}}/api/v1/memories/{{memory_id}}/publish",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200
        }
      ]
    },
    {
      "case_id": "ST-S06-10",
      "type": "exception",
      "description": "补草拟不覆盖用户编辑过的字段",
      "covers": "EX-7.1",
      "steps": [
        { "step": "前置：制造降级草稿", "include": "fragment:degraded_draft", "expected_status": 201 },
        {
