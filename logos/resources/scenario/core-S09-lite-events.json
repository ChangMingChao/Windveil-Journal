
{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S09",
  "name": "先记一下并随手划掉",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S09-lite-events.md",
    "api": ["logos/resources/api/lite-events.yaml"],
    "test_cases": "logos/resources/test/core-S09-test-cases.md"
  },
  "external_dependencies": [],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "建立匿名账号（S09 无外部依赖，无时钟注入需求）",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "body": { "timezone": "Asia/Shanghai" },
      "expected_status": 201,
      "extract": { "access_token": "body.access_token", "user_id": "body.user.id" }
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "逐条收走轻事件（硬删除）",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/lite-events/{{item.id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "for_each": "GET {{base_url}}/api/v1/lite-events?include_done=true -> body.items",
      "expected_status": [204, 404]
    }
  ],
  "flows": [
    {
      "case_id": "ST-S09-01",
      "type": "normal",
      "description": "记下 → 列表 → 划掉 → 收走全链路（outbox 全程无轻事件记录）",
      "covers_steps": "Step 1→22",
      "steps": [
        { "step": "Step 8→13: 记下第一条", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "今晚吃火锅" }, "expected_status": 201, "extract": { "event_a": "body.id" }, "assert": ["body.status == 'open'", "body.text == '今晚吃火锅'", "body.closed_at == null"] },
        { "step": "Step 8→13: 记下第二条", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "周末取快递" }, "expected_status": 201, "extract": { "event_b": "body.id" } },
        { "step": "Step 3→7: 列表按最近在上", "method": "GET", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 2", "body.items[0].text == '周末取快递'"] },
        { "step": "Step 14→18: 划掉第一条", "method": "POST", "url": "{{base_url}}/api/v1/lite-events/{{event_a}}/done", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.status == 'done'", "body.closed_at != null"] },
        { "step": "默认列表只剩 open", "method": "GET", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 1", "body.items[0].id == '{{event_b}}'"] },
        { "step": "Step 19→22: 收走第二条", "method": "DELETE", "url": "{{base_url}}/api/v1/lite-events/{{event_b}}", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 204 },
        { "step": "EX-22.1: 重复收走 404", "method": "DELETE", "url": "{{base_url}}/api/v1/lite-events/{{event_b}}", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 404, "assert": ["body.code == 'LITE_EVENT_NOT_FOUND'"] },
        { "step": "AC-02: outbox 全程无轻事件记录", "method": "GET", "url": "{{base_url}}/api/test/outbox", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 0"] }
      ]
    },
    {
      "case_id": "ST-S09-02",
      "type": "abnormal",
      "description": "空内容与超长内容双层拒绝（EX-9.1）",
      "covers_steps": "EX-9.1",
      "steps": [
        { "step": "空文本被拒", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "" }, "expected_status": 422, "assert": ["body.code == 'VALIDATION_FAILED'"] },
        { "step": "全空白被拒", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "   " }, "expected_status": 422 },
        { "step": "超 200 字被拒", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "长" }, "expected_status": 422 },
        { "step": "无任何写入", "method": "GET", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 0"] }
      ]
    },
    {
      "case_id": "ST-S09-03",
      "type": "normal",
      "description": "轻事件与愿望互不干扰（AC-02 结构性保证）",
      "covers_steps": "S09 验收-正常2",
      "steps": [
        { "step": "前置：种下一个愿望并约定时机", "method": "POST", "url": "{{base_url}}/api/v1/wishes", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "source": "text", "text": "想在冬天学会滑雪" }, "expected_status": 201, "extract": { "wish_id": "body.wish.id" } },
        { "step": "前置：确认 outbox 初始状态", "method": "GET", "url": "{{base_url}}/api/test/outbox", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 0"] },
        { "step": "记下 / 划掉 / 收走一条轻事件", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "随手记一条" }, "expected_status": 201, "extract": { "lite_id": "body.id" } },
        { "step": "划掉", "method": "POST", "url": "{{base_url}}/api/v1/lite-events/{{lite_id}}/done", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200 },
        { "step": "轻事件操作不影响愿望", "method": "GET", "url": "{{base_url}}/api/v1/wishes/{{wish_id}}", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.state == 'seeded'", "body.timing.label != null"] },
        { "step": "outbox 仍无任何记录", "method": "GET", "url": "{{base_url}}/api/test/outbox", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 0"] }
      ]
    },
    {
      "case_id": "ST-S09-04",
      "type": "abnormal",
      "description": "跨用户隔离：全部 404，不暴露存在性",
      "covers_steps": "EX-22.1",
      "steps": [
        { "step": "前置：账号 A 记下一条", "method": "POST", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "text": "只给 A 看的一条" }, "expected_status": 201, "extract": { "event_a": "body.id" } },
        { "step": "账号 B 记一条（取得 B 的 token 用于请求 A 的资源）", "method": "POST", "url": "{{base_url}}/api/v1/auth/anonymous", "expected_status": 201, "extract": { "token_b": "body.access_token" } },
        { "step": "B 请求 A 的列表 → 空", "method": "GET", "url": "{{base_url}}/api/v1/lite-events", "headers": { "Authorization": "Bearer {{token_b}}" }, "expected_status": 200, "assert": ["body.items.length == 0"] },
        { "step": "B 划掉 A 的轻事件 → 404", "method": "POST", "url": "{{base_url}}/api/v1/lite-events/{{event_a}}/done", "headers": { "Authorization": "Bearer {{token_b}}" }, "expected_status": 404, "assert": ["body.code == 'LITE_EVENT_NOT_FOUND'"] },
        { "step": "B 收走 A 的轻事件 → 404", "method": "DELETE", "url": "{{base_url}}/api/v1/lite-events/{{event_a}}", "headers": { "Authorization": "Bearer {{token_b}}" }, "expected_status": 404 }
      ]
    }
  ],
  "not_orchestrated": [
    {
      "case_id": "ST-S09-05",
      "reason": "P1「先记一下」展开/收起与空态文案走查为人工视觉验证 [manual]。"
    },
    {
      "case_id": "UT-S09-05 / UT-S09-06 / UT-S09-07 / UT-S09-08",
      "reason": "DB CHECK / 部分索引 / 结构性无提醒路径断言在代码级（test_s09_db 等）以直查实现，不依赖 HTTP 编排。"
    }
  ]
}