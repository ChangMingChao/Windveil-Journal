## ADDED — S10 API 编排测试

{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S10",
  "name": "管理提醒通道",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S10-channels.md",
    "api": ["logos/resources/api/auth.yaml", "logos/resources/api/wishes.yaml", "logos/resources/api/system.yaml"],
    "test_cases": "logos/resources/test/core-S10-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "系统时钟",
      "test_strategy": "fixed-value",
      "test_config": "POST /api/test/clock 注入固定时间；置 null 恢复真实时钟"
    },
    {
      "name": "Web Push",
      "test_strategy": "env-disable",
      "test_config": "APP_ENV=test 时不真实投递，仅写 reminder_outbox 并按成功记账"
    },
    {
      "name": "邮件服务",
      "test_strategy": "test-api",
      "test_config": "GET /api/test/latest-email?to={email}"
    }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "固定时钟",
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": "2026-09-01T12:00:00+08:00" },
      "expected_status": 204
    },
    {
      "step": "setup-2",
      "description": "建立账号并绑定邮箱（邮件兜底需要收件地址）",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "body": { "timezone": "Asia/Shanghai" },
      "expected_status": 201,
      "extract": { "access_token": "body.access_token", "user_id": "body.user.id" }
    },
    {
      "step": "setup-3",
      "description": "注册 push 订阅（验证关 push 后直接走邮件）",
      "method": "POST",
      "url": "{{base_url}}/api/test/push-subscription",
      "body": { "user_id": "{{user_id}}" },
      "expected_status": 204
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "恢复真实时钟与默认开关",
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": null },
      "expected_status": 204
    }
  ],
  "flows": [
    {
      "case_id": "ST-S10-01",
      "type": "normal",
      "description": "关闭推送保留邮件：投递直接走邮件，订阅保留",
      "covers_steps": "Step 1→10 + D2",
      "steps": [
        { "step": "前置：种下愿望并约定 1 个月后", "method": "POST", "url": "{{base_url}}/api/v1/wishes", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "source": "text", "text": "想在冬天学会滑雪" }, "expected_status": 201, "extract": { "wish_id": "body.wish.id" } },
        { "step": "PUT timing after_months=1", "method": "PUT", "url": "{{base_url}}/api/v1/wishes/{{wish_id}}/timing", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "type": "after_months", "after_months": 1 }, "expected_status": 200 },
        { "step": "Step 6→10: 关闭推送", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "push_enabled": false }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == true"] },
        { "step": "时钟推进到触发后", "method": "POST", "url": "{{base_url}}/api/test/clock", "body": { "now": "2026-10-21T12:00:00+08:00" }, "expected_status": 204 },
        { "step": "D2: 投递一轮 → 直接走邮件", "method": "POST", "url": "{{base_url}}/api/test/scheduler/tick", "expected_status": 200, "assert": ["body.delivered >= 1"] },
        { "step": "断言 channel=email 且订阅未删", "method": "GET", "url": "{{base_url}}/api/test/outbox", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.items.length == 1", "body.items[0].channel == 'email'"] }
      ]
    },
    {
      "case_id": "ST-S10-02",
      "type": "normal",
      "description": "全关 = 完全静默；重开恢复投递且不丢时机",
      "covers_steps": "验收-正常2 + EX-D2.1",
      "steps": [
        { "step": "前置：种下愿望并约定时机（复用上 flow 状态亦可，此 flow 独立重置）", "method": "POST", "url": "{{base_url}}/api/v1/wishes", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "source": "text", "text": "想重新开始画画" }, "expected_status": 201, "extract": { "wish_id2": "body.wish.id" } },
        { "step": "PUT timing", "method": "PUT", "url": "{{base_url}}/api/v1/wishes/{{wish_id2}}/timing", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "type": "after_months", "after_months": 1 }, "expected_status": 200 },
        { "step": "全关", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "push_enabled": false, "email_enabled": false }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == false"] },
        { "step": "时钟推进后投递一轮", "method": "POST", "url": "{{base_url}}/api/test/clock", "body": { "now": "2026-11-01T12:00:00+08:00" }, "expected_status": 204 },
        { "step": "D2: 全关跳过——outbox 保持 pending", "method": "POST", "url": "{{base_url}}/api/test/scheduler/tick", "expected_status": 200, "assert": ["body.delivered == 0"] },
        { "step": "outbox pending 未被删除且 attempts 不变", "method": "GET", "url": "{{base_url}}/api/test/outbox", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["every(i in body.items : i.status != 'failed')"] },
        { "step": "重开 email", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "email_enabled": true }, "expected_status": 200 },
        { "step": "再投递一轮 → 恢复投递", "method": "POST", "url": "{{base_url}}/api/test/scheduler/tick", "expected_status": 200, "assert": ["body.delivered >= 1"] }
      ]
    },
    {
      "case_id": "ST-S10-03",
      "type": "normal",
      "description": "快速连续切换互不牵连（验收-异常）",
      "covers_steps": "验收-异常",
      "steps": [
        { "step": "只关 push", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "push_enabled": false }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == true"] },
        { "step": "只关 email（push 仍关）", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "email_enabled": false }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == false"] },
        { "step": "只开 email（push 保持关）", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{access_token}}" }, "body": { "email_enabled": true }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == true"] },
        { "step": "愿望与轻事件数据不变", "method": "GET", "url": "{{base_url}}/api/v1/wishes/{{wish_id}}", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.state == 'brewing'"] }
      ]
    },
    {
      "case_id": "ST-S10-04",
      "type": "abnormal",
      "description": "开关只作用于当前 token 用户（跨用户天然隔离）",
      "covers_steps": "验收-异常（token 语义）",
      "steps": [
        { "step": "新建账号 B", "method": "POST", "url": "{{base_url}}/api/v1/auth/anonymous", "expected_status": 201, "extract": { "token_b": "body.access_token" } },
        { "step": "B 关闭自己的推送", "method": "PATCH", "url": "{{base_url}}/api/v1/me/notification-channels", "headers": { "Authorization": "Bearer {{token_b}}" }, "body": { "push_enabled": false }, "expected_status": 200 },
        { "step": "A 的开关不受影响", "method": "GET", "url": "{{base_url}}/api/v1/me", "headers": { "Authorization": "Bearer {{access_token}}" }, "expected_status": 200, "assert": ["body.push_enabled == false", "body.email_enabled == true"] }
      ]
    }
  ],
  "not_orchestrated": [
    { "case_id": "ST-S10-05", "reason": "全关文案与触控区走查为人工视觉验证 [manual]。" },
    { "case_id": "UT-S10-01 / UT-S10-04 / UT-S10-05", "reason": "请求体校验与数据隔离断言属代码级，由 test_s10_units 覆盖。" }
  ]
}
