## ADDED — S08 API 编排测试

{
  "$schema_note": "OpenLogos API 编排测试（Phase 3 Step 4b）。flow.case_id 复用 Step 4a 的 ST-* ID；结果写入 logos/resources/verify/test-results.jsonl。",
  "scenario": "S08",
  "name": "管理偏好与可用时段",
  "source": {
    "sequence": "logos/resources/prd/3-technical-plan/2-scenario-implementation/core-S08-preferences-availability.md",
    "api": ["logos/resources/api/auth.yaml", "logos/resources/api/wishes.yaml"],
    "test_cases": "logos/resources/test/core-S08-test-cases.md"
  },
  "external_dependencies": [
    {
      "name": "LLM",
      "test_strategy": "mock-service",
      "test_config": "本地 OpenAI 兼容 mock；PUT /_control {mode: summarize_digest} 供摘要支线使用"
    },
    {
      "name": "系统时钟",
      "test_strategy": "fixed-value",
      "test_config": "POST /api/test/clock 注入固定时间；置 null 恢复真实时钟"
    }
  ],
  "variables": {
    "base_url": "${API_BASE_URL:-http://localhost:8000}",
    "mock_base": "${AGENT_MOCK_BASE:-http://localhost:9100}"
  },
  "setup": [
    {
      "step": "setup-1",
      "description": "固定时钟，使摘要周期与过期扫描可复现",
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": "2026-09-01T12:00:00+08:00" },
      "expected_status": 204
    },
    {
      "step": "setup-2",
      "description": "建立匿名账号",
      "method": "POST",
      "url": "{{base_url}}/api/v1/auth/anonymous",
      "body": { "timezone": "Asia/Shanghai" },
      "expected_status": 201,
      "extract": { "access_token": "body.access_token", "user_id": "body.user.id" }
    }
  ],
  "teardown": [
    {
      "step": "teardown-1",
      "description": "恢复真实时钟",
      "method": "POST",
      "url": "{{base_url}}/api/test/clock",
      "body": { "now": null },
      "expected_status": 204
    },
    {
      "step": "teardown-2",
      "description": "逐条删除偏好（含摘要行）",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/me/preferences/{{item.id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "for_each": "GET {{base_url}}/api/v1/me/preferences?include_revoked=true -> body.items + body.digest",
      "expected_status": [204, 404]
    },
    {
      "step": "teardown-3",
      "description": "逐条删除可用时段",
      "method": "DELETE",
      "url": "{{base_url}}/api/v1/me/availability/{{item.id}}",
      "headers": { "Authorization": "Bearer {{access_token}}" },
      "for_each": "GET {{base_url}}/api/v1/me/availability -> body.items",
      "expected_status": [204, 404]
    }
  ],
  "flows": [
    {
      "case_id": "ST-S08-01",
      "type": "normal",
      "description": "查看记忆：空→声明→读回（含写响应不回显断言）",
      "covers_steps": "Step 1→11 + EX-6.1",
      "steps": [
        {
          "step": "Step 2→6: 首次查看为空",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.items.length == 0", "body.digest == null"]
        },
        {
          "step": "Step 7→11: 声明一条偏好",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "pref_key": "companion", "value": "更想和朋友一起做这些事" },
          "expected_status": 200,
          "assert": [
            "body.source == 'declared'",
            "body.confidence == 100",
            "body.value == undefined"
          ]
        },
        {
          "step": "Step 2→6: 读回（GET 回显明文，仅本人）",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": [
            "body.items.length == 1",
            "body.items[0].pref_key == 'companion'",
            "body.items[0].source == 'declared'",
            "body.items[0].value == '更想和朋友一起做这些事'"
          ]
        }
      ]
    },
    {
      "case_id": "ST-S08-04",
      "type": "normal",
      "description": "删除偏好为硬删除，不留影子",
      "covers_steps": "Step 17→20 + EX-19.1",
      "steps": [
        {
          "step": "前置：声明一条偏好",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "pref_key": "pace", "value": "节奏慢一点也没关系" },
          "expected_status": 200,
          "extract": { "pref_id": "body.id" }
        },
        {
          "step": "Step 18: 删除",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/me/preferences/{{pref_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 204
        },
        {
          "step": "EX-19.1: 默认与 include_revoked 均不可见",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/preferences?include_revoked=true",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.items.length == 0"]
        },
        {
          "step": "EX-19.1: 重复删除 404（资源不存在）",
          "method": "DELETE",
          "url": "{{base_url}}/api/v1/me/preferences/{{pref_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 404
        }
      ]
    },
    {
      "case_id": "ST-S08-05",
      "type": "normal",
      "description": "可用时段管理与非法输入（EX-23.1）",
      "covers_steps": "Step 21→25 + EX-23.1",
      "steps": [
        {
          "step": "Step 21→25: 新增合法时段",
          "method": "POST",
          "url": "{{base_url}}/api/v1/me/availability",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "weekday": 5, "start_minute": 540, "end_minute": 720, "note": "上午有空" },
          "expected_status": 201,
          "extract": { "window_id": "body.id" },
          "assert": ["body.weekday == 5", "body.note == undefined"]
        },
        {
          "step": "EX-23.1: 结束早于开始被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/me/availability",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "weekday": 5, "start_minute": 840, "end_minute": 780 },
          "expected_status": 422,
          "assert": ["body.code == 'AVAILABILITY_INVALID'"]
        },
        {
          "step": "EX-23.1: weekday 越界被拒",
          "method": "POST",
          "url": "{{base_url}}/api/v1/me/availability",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "weekday": 7, "start_minute": 540, "end_minute": 720 },
          "expected_status": 422
        },
        {
          "step": "PATCH: 修改时段",
          "method": "PATCH",
          "url": "{{base_url}}/api/v1/me/availability/{{window_id}}",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "end_minute": 780 },
          "expected_status": 200,
          "assert": ["body.end_minute == 780"]
        },
        {
          "step": "GET: 读回含备注明文（仅本人）",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/availability",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.items.length == 1", "body.items[0].note == '上午有空'"]
        }
      ]
    },
    {
      "case_id": "ST-S08-06",
      "type": "normal",
      "description": "摘要支线：生成、单份覆盖与降级保持（D1–D4 / EX-D2.1）",
      "covers_steps": "D1→D4、EX-D2.1",
      "steps": [
        {
          "step": "前置：声明两条偏好作为摘要语料",
          "method": "PUT",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "body": { "pref_key": "relaxation", "value": "想要喘口气" },
          "expected_status": 200
        },
        {
          "step": "前置：mock 置 summarize_digest 模式",
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "summarize_digest" },
          "expected_status": 204
        },
        {
          "step": "D1→D4: 触发一次调度轮（含低频摘要任务）",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200
        },
        {
          "step": "D4: digest 行已生成",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.digest != null", "body.digest.kind == 'digest'", "body.digest.source == 'inferred'", "body.digest.value != null"]
        },
        {
          "step": "EX-D2.1: mock 失败后再触发一轮，旧 digest 保持",
          "method": "PUT",
          "url": "{{mock_base}}/_control",
          "body": { "mode": "timeout" },
          "expected_status": 204
        },
        {
          "step": "再触发一轮调度",
          "method": "POST",
          "url": "{{base_url}}/api/test/scheduler/tick",
          "expected_status": 200
        },
        {
          "step": "EX-D2.1: digest 未被破坏",
          "method": "GET",
          "url": "{{base_url}}/api/v1/me/preferences",
          "headers": { "Authorization": "Bearer {{access_token}}" },
          "expected_status": 200,
          "assert": ["body.digest != null", "contains(body.digest.value, '喘')"]
        }
      ]
    }
  ],
  "not_orchestrated": [
    {
      "case_id": "ST-S08-02",
      "reason": "声明与推断并列需要预置 source=inferred 的行，编排环境无 DB fixture 能力（推断写入链路属后续工具提案），由 UT-S08-15 在代码级以 fixture 覆盖。"
    },
    {
      "case_id": "ST-S08-03",
      "reason": "撤回联动同样依赖 inferred fixture（撤回仅对 inferred 行有意义）；其中「删除可用时段 → pending 建议失效」的同源联动已由 ST-S03-18 通过纯 API 路径覆盖。"
    },
    {
      "case_id": "ST-S08-07 / ST-S08-08",
      "reason": "来源徽标视觉分层与空态/文案走查为人工视觉验证 [manual]。"
    }
  ]
}
